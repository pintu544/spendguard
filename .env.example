# SpendGuard spike credentials — TESTNET ONLY.
# Copy this file to `.env`, fill in real values, and `chmod 600 .env`.
# `.env` is gitignored and must NEVER be committed.
#
# The account id of the testnet wallet the spike signs with
# (named account, e.g. yourname.testnet — created by the human, see SPIKE.md).
NEAR_ACCOUNT_ID=
# The FULL-ACCESS private key for that account, as exported by the wallet,
# in `ed25519:...` form. Used once to create the scoped function-call key;
# the scoped key it creates is what the agent process would hold.
NEAR_PRIVATE_KEY=
# Network: testnet (only testnet is used by this project)
NEAR_NETWORK=testnet
# Optional: override the testnet RPC endpoint (default https://rpc.testnet.near.org)
# NEAR_RPC_URL=

# --- SpendGuard build (added with the guard-contract design) ---
# The guard contract account id, printed by `npm run deploy:guard`
# (default for a named agent account: guard.<your account>).
# NEAR_GUARD_CONTRACT_ID=
# The agent's SCOPED function-call private key (release-only on the guard
# contract), printed ONCE by `npm run deploy:guard`. This is the only key
# the agent/demo process needs after deploy.
# NEAR_SCOPED_PRIVATE_KEY=
# The guard account's full-access private key, printed ONCE by
# `npm run deploy:guard`. Human keeps it (redeploy/recovery); the demo
# never uses it.
# NEAR_GUARD_PRIVATE_KEY=
# Optional deploy knobs: NEAR_GUARD_FUND_NEAR (default 2),
# NEAR_SCOPED_KEY_ALLOWANCE_NEAR (default 1).
