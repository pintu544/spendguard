# SpendGuard spike credentials — TESTNET ONLY.
# Copy this file to `.env`, fill in real values, and `chmod 600 .env`.
# `.env` is gitignored and must NEVER be committed.
#
# The account id of the testnet wallet the spike signs with
# (named account, e.g. yourname.testnet — created by the human, see SPIKE.md).
NEAR_ACCOUNT_ID=
# The FULL-ACCESS private key for that account, as exported by the wallet,
# in `ed25519:...` form. Used once to create the scoped function-call key;
# the scoped key it creates is what the agent process would hold.
NEAR_PRIVATE_KEY=
# Network: testnet (only testnet is used by this project)
NEAR_NETWORK=testnet
# Optional: override the testnet RPC endpoint (default https://rpc.testnet.near.org)
# NEAR_RPC_URL=
